# 個人設定は共有しない（hook 定義の .claude/settings.json は共有する）
.claude/settings.local.json

# Unity の native plugin 置き場。dev.ps1 build がビルド成果物（.dll/.dylib/.so）を
# 写すので、それらは追跡しない。ただし .meta は Unity の import 設定そのもの
# （どの platform 向けかを PluginImporter が記録する）であり、無いと利用者の
# 環境で「全 platform 有効」の既定に戻り、3 つの binary が読み込みで衝突する
# （M3 Task 6）。ディレクトリ丸ごとの ignore はしない。
Packages/com.ayutaz.opencv-unity-native/Runtime/Plugins/**/*.dll
Packages/com.ayutaz.opencv-unity-native/Runtime/Plugins/**/*.dylib
Packages/com.ayutaz.opencv-unity-native/Runtime/Plugins/**/*.so

# tests/UnityProject は Unity が起動のたびに生成するキャッシュ・ローカル成果物を持つ。
# ルートの [Oo]bj/ は既に効くが、Library/ Logs/ UserSettings/ Temp/ とプロジェクト直下に
# 生成される .csproj/.sln はここでしか出ないので明示する
# （ルート直下の tests/Managed/CvUnity.Managed.sln は追跡対象であり、無条件の *.sln は書けない）。
tests/UnityProject/Library/
tests/UnityProject/Temp/
tests/UnityProject/Logs/
tests/UnityProject/UserSettings/
tests/UnityProject/*.csproj
tests/UnityProject/*.sln
