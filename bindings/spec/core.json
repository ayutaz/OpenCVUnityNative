{
  "module": "core",
  "functions": [
    {
      "name": "ocvu_mat_create",
      "summary": "rows x cols、指定 type の Mat を確保し、handle を out_handle に書く。rows / cols が 1 未満、または type が未知なら OCVU_STATUS_INVALID_ARGUMENT を返し out_handle は変更しない。out_handle が NULL なら OCVU_STATUS_NULL_POINTER。",
      "returns": "ocvu_status",
      "csReturns": "int",
      "wrapInTryBarrier": true,
      "params": [
        { "name": "rows", "cType": "int32_t", "csType": "int", "direction": "in" },
        { "name": "cols", "cType": "int32_t", "csType": "int", "direction": "in" },
        { "name": "type", "cType": "int32_t", "csType": "int", "direction": "in" },
        { "name": "out_handle", "cType": "ocvu_mat_handle*", "csType": "out ulong", "direction": "out" }
      ]
    },
    {
      "name": "ocvu_mat_release",
      "summary": "handle を解放する。解放済み、または未知の handle なら OCVU_STATUS_INVALID_HANDLE を返す（落とさない）。",
      "returns": "ocvu_status",
      "csReturns": "int",
      "wrapInTryBarrier": true,
      "params": [
        { "name": "handle", "cType": "ocvu_mat_handle", "csType": "ulong", "direction": "in" }
      ]
    },
    {
      "name": "ocvu_mat_clone",
      "summary": "src の内容を複製した独立の handle を作る。src と複製は別の記憶域を持つ。",
      "returns": "ocvu_status",
      "csReturns": "int",
      "wrapInTryBarrier": true,
      "params": [
        { "name": "src", "cType": "ocvu_mat_handle", "csType": "ulong", "direction": "in" },
        { "name": "out_handle", "cType": "ocvu_mat_handle*", "csType": "out ulong", "direction": "out" }
      ]
    },
    {
      "name": "ocvu_mat_get_info",
      "summary": "handle の形状を out_info に書く。out_info が NULL なら OCVU_STATUS_NULL_POINTER。",
      "returns": "ocvu_status",
      "csReturns": "int",
      "wrapInTryBarrier": true,
      "params": [
        { "name": "handle", "cType": "ocvu_mat_handle", "csType": "ulong", "direction": "in" },
        { "name": "out_info", "cType": "ocvu_mat_info*", "csType": "out OcvuMatInfo", "direction": "out" }
      ]
    },
    {
      "name": "ocvu_mat_copy_from_buffer",
      "summary": "外部 buffer から Mat へコピーする。src は呼び出しの内側でだけ読む借用で、戻った後 native は一切保持しない。長さと stride は書く前にすべて検証し、1 つでも合わなければ何も書かずに返す。src_stride は Mat の step と異なってよく、行ごとにコピーする。",
      "returns": "ocvu_status",
      "csReturns": "int",
      "wrapInTryBarrier": true,
      "params": [
        { "name": "dst", "cType": "ocvu_mat_handle", "csType": "ulong", "direction": "in" },
        { "name": "src", "cType": "const uint8_t*", "csType": "byte[]", "direction": "in-buffer" },
        { "name": "src_length", "cType": "int64_t", "csType": "long", "direction": "in" },
        { "name": "src_stride", "cType": "int64_t", "csType": "long", "direction": "in" }
      ]
    },
    {
      "name": "ocvu_mat_copy_from_buffer_ptr",
      "summary": "ocvu_mat_copy_from_buffer にアドレスを直接渡す C# 側の入口。NativeArray や Texture2D の生データを managed 配列へ写さずに渡すためにある。領域はこの呼び出しが戻るまで生きていなければならない。",
      "returns": "ocvu_status",
      "csReturns": "int",
      "wrapInTryBarrier": true,
      "entryPoint": "ocvu_mat_copy_from_buffer",
      "params": [
        { "name": "dst", "cType": "ocvu_mat_handle", "csType": "ulong", "direction": "in" },
        { "name": "src", "cType": "const uint8_t*", "csType": "System.IntPtr", "direction": "in-buffer" },
        { "name": "src_length", "cType": "int64_t", "csType": "long", "direction": "in" },
        { "name": "src_stride", "cType": "int64_t", "csType": "long", "direction": "in" }
      ]
    },
    {
      "name": "ocvu_mat_copy_to_buffer",
      "summary": "Mat から外部 buffer へコピーする。借用と検証の規則は ocvu_mat_copy_from_buffer と同じである。",
      "returns": "ocvu_status",
      "csReturns": "int",
      "wrapInTryBarrier": true,
      "params": [
        { "name": "src", "cType": "ocvu_mat_handle", "csType": "ulong", "direction": "in" },
        { "name": "dst", "cType": "uint8_t*", "csType": "byte[]", "direction": "out-buffer" },
        { "name": "dst_length", "cType": "int64_t", "csType": "long", "direction": "in" },
        { "name": "dst_stride", "cType": "int64_t", "csType": "long", "direction": "in" }
      ]
    },
    {
      "name": "ocvu_mat_copy_to_buffer_ptr",
      "summary": "ocvu_mat_copy_to_buffer にアドレスを直接渡す C# 側の入口。借用の契約は ocvu_mat_copy_from_buffer_ptr と同じである。",
      "returns": "ocvu_status",
      "csReturns": "int",
      "wrapInTryBarrier": true,
      "entryPoint": "ocvu_mat_copy_to_buffer",
      "params": [
        { "name": "src", "cType": "ocvu_mat_handle", "csType": "ulong", "direction": "in" },
        { "name": "dst", "cType": "uint8_t*", "csType": "System.IntPtr", "direction": "out-buffer" },
        { "name": "dst_length", "cType": "int64_t", "csType": "long", "direction": "in" },
        { "name": "dst_stride", "cType": "int64_t", "csType": "long", "direction": "in" }
      ]
    }
  ]
}
